generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Prix et limites : voir src/lib/plans.ts
enum Plan {
  FREE // sans abonnement : les prêts restent consultables, pas de nouveau prêt (sauf en phase de test)
  ENTREPRISE_YEARLY // offre Entreprise, 299 € HT par an
}

enum LoanKind {
  OBJECT
  MONEY
}

enum LoanStatus {
  ACTIVE
  RETURNED
}

/**
 * Accusé de réception du prêt, signé par l'emprunteur (src/lib/receipts.ts).
 */
enum AckStatus {
  NONE // prêt enregistré avant les accusés de réception : aucune signature demandée
  PENDING // demande envoyée à l'emprunteur, en attente de sa signature
  SIGNED // accusé de réception signé
  REFUSED // l'emprunteur conteste le prêt : plus aucun rappel ne lui est envoyé
}

enum ReceiptKind {
  LOAN // accusé de réception du prêt, signé par l'emprunteur
  REPAYMENT // reçu d'un remboursement, signé par le prêteur
  RETURN // attestation de restitution de l'objet, signée par le prêteur
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  // structure cliente (entreprise, association…) : responsable du traitement des données de ses emprunteurs,
  // nommée dans les e-mails et les documents signés. Obligatoire avant le premier prêt.
  organization          String?
  passwordHash          String
  role                  Role      @default(USER)
  disabled              Boolean   @default(false)
  plan                  Plan      @default(FREE)
  planExpiresAt         DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  // abonnement résilié : reste actif jusqu'à planExpiresAt puis n'est pas renouvelé
  cancelAtPeriodEnd     Boolean   @default(false)
  // conclusion de l'abonnement en cours : point de départ du délai de rétractation de 14 jours
  subscriptionStartedAt DateTime?
  // passage du site au mode payant : date annoncée à cet utilisateur par e-mail (un seul e-mail par date)
  paidModeNoticeFor     DateTime?
  createdAt             DateTime  @default(now())
  // dernière activité (connexion ou ouverture de l'appli) : sert à la purge des comptes inactifs
  lastLoginAt           DateTime?
  // RGPD / consommation : preuve d'acceptation des CGU et des CGV
  termsAcceptedAt       DateTime?
  termsVersion          String?
  salesTermsAcceptedAt  DateTime?
  // préavis envoyés (reconduction d'un abonnement annuel, suppression pour inactivité)
  renewalNoticeAt       DateTime?
  inactivityNoticeAt    DateTime?
  // adresse e-mail confirmée par un lien : sans ça, pas de rattachement des emprunts ni d'envoi aux emprunteurs
  emailVerifiedAt       DateTime?
  // nouvelle adresse demandée, en attente de confirmation par un lien envoyé à cette adresse
  pendingEmail          String?

  loansGiven    Loan[]         @relation("lender")
  loansReceived Loan[]         @relation("borrower")
  notifications Notification[]
  payments      Payment[]
  emailsSent    EmailLog[]
  sessions      Session[]
  authTokens    AuthToken[]
}

/**
 * Session de connexion (une par appareil) : la supprimer déconnecte l'appareil, même avec un jeton encore valide.
 */
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/**
 * Lien à usage unique envoyé par e-mail. Seule l'empreinte SHA-256 du jeton est stockée.
 */
model AuthToken {
  id        String        @id @default(cuid())
  kind      AuthTokenKind
  tokenHash String        @unique
  // adresse à laquelle le lien a été envoyé (adresse actuelle ou nouvelle adresse à confirmer)
  email     String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model Loan {
  id             String     @id @default(cuid())
  kind           LoanKind   @default(OBJECT)
  // objet prêté, ou motif pour un prêt d'argent
  item           String
  // prêt d'argent : montant prêté et déjà remboursé (en centimes)
  amountCents    Int?
  repaidCents    Int        @default(0)
  currency       String     @default("eur")
  description    String?
  borrowerName   String
  borrowerEmail  String
  borrowerPhone  String?
  lentAt         DateTime   @default(now())
  dueAt          DateTime
  status         LoanStatus @default(ACTIVE)
  returnedAt     DateTime?
  // rappel automatique par e-mail à l'emprunteur quand l'échéance est passée
  autoReminder   Boolean    @default(true)
  // rappel J-1 avant l'échéance
  remindBefore   Boolean    @default(true)
  lastReminderAt DateTime?
  reminderCount  Int        @default(0)
  notes          String?
  createdAt      DateTime   @default(now())

  // Accusé de réception signé par l'emprunteur. Les prêts antérieurs à cette fonction sont à NONE.
  ackStatus        AckStatus @default(PENDING)
  // version de la demande : augmente quand le prêt est modifié, ce qui rend caducs les liens de signature déjà envoyés
  ackVersion       Int       @default(1)
  ackRequestedAt   DateTime?
  // relance automatique de la demande de signature (une seule par version)
  ackRemindedAt    DateTime?
  // date de la signature ou de la contestation
  ackAt            DateTime?
  // motif donné par l'emprunteur qui conteste le prêt
  ackRefusalReason String?

  lenderId   String
  lender     User    @relation("lender", fields: [lenderId], references: [id], onDelete: Cascade)
  // renseigné si l'e-mail de l'emprunteur correspond à un compte
  borrowerId String?
  borrower   User?   @relation("borrower", fields: [borrowerId], references: [id], onDelete: SetNull)

  repayments Repayment[]
  receipts   Receipt[]

  @@index([lenderId, status])
  @@index([borrowerEmail])
  @@index([status, dueAt])
}

/**
 * Remboursement (partiel ou total) d'un prêt d'argent.
 */
model Repayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())
  // reçu signé par le prêteur (absent pour les remboursements enregistrés avant les reçus)
  receipt     Receipt?

  @@index([loanId])
}

/**
 * Document signé électroniquement : accusé de réception, reçu de remboursement ou attestation de retour.
 * Figé à la signature : contenu lu par le signataire, tracé de la signature, éléments de preuve et empreinte
 * SHA-256 de l'ensemble (art. 1366 C. civ.). Le PDF est recalculé à l'identique depuis ces données.
 * Supprimé avec le prêt : le prêteur garde sa copie imprimée (CGU), Prêt Matériel n'archive pas.
 */
model Receipt {
  id           String      @id @default(cuid())
  // numéro imprimé sur le document (AR-…, RR-…, AT-…)
  number       String      @unique
  kind         ReceiptKind
  loanId       String
  loan         Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  repaymentId  String?     @unique
  repayment    Repayment?  @relation(fields: [repaymentId], references: [id], onDelete: Cascade)
  // ce que le signataire a lu et signé : parties, objet ou somme, dates, déclaration
  content      Json
  // tracé de la signature (points, pas d'image) ou signature au clavier
  signature    Json
  signerName   String
  signerEmail  String
  signedAt     DateTime    @default(now())
  // éléments de preuve
  ip           String?
  userAgent    String?
  hash         String
  // premier téléchargement par le prêteur : tant qu'il est vide, l'appli lui rappelle d'imprimer le document
  downloadedAt DateTime?

  @@index([loanId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountCents Int
  currency    String   @default("eur")
  plan        Plan
  provider    String   @default("stripe")
  providerRef String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitorId String
  device    String?
  browser   String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  kind       String
  ok         Boolean
  error      String?
  // e-mail envoyé à un tiers (emprunteur) au nom d'un prêteur : sert aux plafonds anti-abus
  thirdParty Boolean  @default(false)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([senderId, kind, createdAt])
  @@index([to, createdAt])
}

enum SiteMode {
  BETA // phase de test : tout est gratuit, aucune offre n'est vendue
  PAID // offres payantes (src/lib/plans.ts)
}

/**
 * Réglages du site, une seule ligne (id = 1), modifiés depuis l'admin. Voir src/lib/sitemode.ts.
 */
model SiteSetting {
  id          Int       @id @default(1)
  mode        SiteMode  @default(BETA)
  // passage au mode payant programmé (au moins 30 jours après l'annonce, CGU art. 10)
  paidFrom    DateTime?
  paidSince   DateTime?
  // clé de signature générée au premier démarrage si JWT_SECRET n'est pas fourni (src/lib/app-secret.ts)
  appSecret   String?
  updatedAt   DateTime  @updatedAt
  updatedById String?
}

/**
 * Adresses qui ne veulent plus recevoir d'e-mails de rappel (droit d'opposition, art. 21 RGPD).
 */
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}
