generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  MONTHLY // 2 €/mois, sans engagement, 10 prêts
  YEARLY_10 // 12 €/an, 10 prêts
  YEARLY_20 // 24 €/an, 20 prêts
}

enum LoanKind {
  OBJECT
  MONEY
}

enum LoanStatus {
  ACTIVE
  RETURNED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  passwordHash         String
  role                 Role      @default(USER)
  disabled             Boolean   @default(false)
  plan                 Plan      @default(FREE)
  planExpiresAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // abonnement résilié : reste actif jusqu'à planExpiresAt puis n'est pas renouvelé
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  // dernière activité (connexion ou ouverture de l'appli) : sert à la purge des comptes inactifs
  lastLoginAt          DateTime?
  // RGPD / consommation : preuve d'acceptation des CGU et des CGV
  termsAcceptedAt      DateTime?
  termsVersion         String?
  salesTermsAcceptedAt DateTime?
  // préavis envoyés (reconduction d'un abonnement annuel, suppression pour inactivité)
  renewalNoticeAt      DateTime?
  inactivityNoticeAt   DateTime?

  loansGiven    Loan[]         @relation("lender")
  loansReceived Loan[]         @relation("borrower")
  notifications Notification[]
  payments      Payment[]
}

model Loan {
  id             String     @id @default(cuid())
  kind           LoanKind   @default(OBJECT)
  // objet prêté, ou motif pour un prêt d'argent
  item           String
  // prêt d'argent : montant prêté et déjà remboursé (en centimes)
  amountCents    Int?
  repaidCents    Int        @default(0)
  currency       String     @default("eur")
  description    String?
  borrowerName   String
  borrowerEmail  String
  borrowerPhone  String?
  lentAt         DateTime   @default(now())
  dueAt          DateTime
  status         LoanStatus @default(ACTIVE)
  returnedAt     DateTime?
  // rappel automatique par e-mail à l'emprunteur quand l'échéance est passée
  autoReminder   Boolean    @default(true)
  // rappel J-1 avant l'échéance
  remindBefore   Boolean    @default(true)
  lastReminderAt DateTime?
  reminderCount  Int        @default(0)
  notes          String?
  createdAt      DateTime   @default(now())

  lenderId   String
  lender     User    @relation("lender", fields: [lenderId], references: [id], onDelete: Cascade)
  // renseigné si l'e-mail de l'emprunteur correspond à un compte
  borrowerId String?
  borrower   User?   @relation("borrower", fields: [borrowerId], references: [id], onDelete: SetNull)

  repayments Repayment[]

  @@index([lenderId, status])
  @@index([borrowerEmail])
  @@index([status, dueAt])
}

/** Remboursement (partiel ou total) d'un prêt d'argent. */
model Repayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([loanId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountCents   Int
  currency      String   @default("eur")
  plan          Plan
  provider      String   @default("stripe")
  providerRef   String   @unique
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  visitorId String
  device    String?
  browser   String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  kind      String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/** Adresses qui ne veulent plus recevoir d'e-mails de rappel (droit d'opposition, art. 21 RGPD). */
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}
