# Base de données PostgreSQL
DATABASE_URL="postgresql://pret:pret@localhost:5432/pret"

# Secret pour signer les sessions (mettre une longue chaîne aléatoire)
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"

# URL publique du site (utilisée dans les e-mails et Stripe)
APP_URL="http://localhost:3000"

# Premier admin : ce compte devient ADMIN à l'inscription (ou via npm run db:seed)
ADMIN_EMAIL="toi@exemple.com"
ADMIN_PASSWORD="change-moi"

# E-mails par l'API web de Brevo (HTTPS) : prioritaire sur le SMTP. Indispensable chez un hébergeur
# qui bloque le SMTP sortant (Railway sur les offres Free, Trial et Hobby). Brevo → SMTP et API → Clés API.
BREVO_API_KEY=""

# SMTP (Brevo, Resend, Mailgun, OVH, Gmail…).
# Avec Docker : vide = les e-mails arrivent dans la boîte de test http://localhost:8025
# Sans Docker : vide = les e-mails sont affichés dans la console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Prêt Matériel <no-reply@exemple.com>"

# Sauvegarde quotidienne de la base vers un stockage S3 (bucket Railway), faite par la tâche horaire.
# Vide = pas de sauvegarde par ce moyen (avec Docker, le service backup s'en charge). Voir src/lib/backup.ts.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
# BACKUP_S3_PATH_STYLE="true"   # anciens buckets, ou serveur S3 de test

# Stripe (carte, PayPal, Apple Pay, Google Pay, SEPA…)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Prix récurrent annuel de l'offre Entreprise, 299 € HT (voir src/lib/plans.ts) : identifiant price_… du dashboard Stripe
STRIPE_PRICE_ENTREPRISE_YEARLY=""

# Sans clés Stripe : true = cliquer sur une offre l'active sans payer (pour tester).
# Mets false avant d'ouvrir le site au public.
DEMO_BILLING="true"

# Protège l'endpoint /api/cron/reminders
CRON_SECRET="change-moi"

# Site derrière Cloudflare : lire l'IP du visiteur dans CF-Connecting-IP (limitation des tentatives).
# Laisser à false sinon : cet en-tête serait falsifiable.
BEHIND_CLOUDFLARE="false"

# ─── Production (docker-compose.prod.yml) ──────────────────────────────────────
# Avec APP_URL en https://, le site REFUSE DE DÉMARRER tant qu'une valeur d'exemple est en place.
# Générer un secret : openssl rand -base64 48
# DOMAIN="pret-materiel.fr"
# APP_URL="https://pret-materiel.fr"
# JWT_SECRET="<chaîne aléatoire, 32 caractères minimum>"
# CRON_SECRET="<autre chaîne aléatoire, 24 caractères minimum>"
# DB_PASSWORD="<mot de passe de la base : à fixer AVANT le premier lancement>"
# ADMIN_EMAIL="toi@ton-domaine.fr"
# ADMIN_PASSWORD="<mot de passe fort>"
# SMTP_HOST="smtp-relay.brevo.com"
